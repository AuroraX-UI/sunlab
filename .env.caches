# Sunlab Desktop - External Cache Paths
#
# All build artifacts and tool binaries stored on large-capacity volume.
# Source this file before running build commands, or let .npmrc handle pnpm.

PNPM_STORE_DIR=/Volumes/fushilu/.caches/pnpm/store
PNPM_CACHE_DIR=/Volumes/fushilu/.caches/pnpm/cache
PNPM_STATE_DIR=/Volumes/fushilu/.caches/pnpm/state
SUNLAB_PNPM_VIRTUAL_STORE=/Volumes/fushilu/.caches/sunlab/pnpm/virtual-store

ELECTRON_CACHE=/Volumes/fushilu/.caches/electron
PLAYWRIGHT_BROWSERS_PATH=/Volumes/fushilu/.caches/ms-playwright

SUNLAB_DIST_DIR=/Volumes/fushilu/.caches/sunlab/desktop/dist
SUNLAB_RELEASE_DIR=/Volumes/fushilu/.caches/sunlab/desktop/release
CARGO_TARGET_DIR=/Volumes/fushilu/.caches/sunlab/cargo-target
npm_config_devdir=/Volumes/fushilu/.caches/node-gyp
